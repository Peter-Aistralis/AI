# DEBUG IMAGE INPUT
# ============================================================

def visualize_game_state():
    env = DinoGame()

    try:
        env.reset()
        time.sleep(0.5)

        raw = np.array(
            env.capture.grab(
                env.game_loc
            )
        )[:, :, :4]

        processed = env._preprocess_frame(
            raw
        )

        stacked = env._get_observation()

        fig, axes = plt.subplots(
            2,
            3,
            figsize=(15, 8)
        )

        axes[0, 0].imshow(raw)
        axes[0, 0].set_title("Raw")
        axes[0, 0].axis("off")

        axes[0, 1].imshow(
            processed,
            cmap="gray"
        )
        axes[0, 1].set_title(
            "Preprocessed 60x100"
        )
        axes[0, 1].axis("off")

        for i in range(4):
            ax = axes.flat[i + 2]

            ax.imshow(
                stacked[i],
                cmap="gray"
            )

            ax.set_title(
                f"Frame {i + 1}"
            )

            ax.axis("off")

        plt.tight_layout()
        plt.show()

        print("\nImage information:")
        print(
            "Raw:",
            raw.shape
        )
        print(
            "Processed:",
            processed.shape
        )
        print(
            "Stacked:",
            stacked.shape
        )
        print(
            "Pixel range:",
            processed.min(),
            "-",
            processed.max()
        )

    finally:
        env.close()


